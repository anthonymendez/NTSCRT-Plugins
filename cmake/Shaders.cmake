# ntscrt_add_shaders(<target> <file.slang>...)
#
# Compiles each Slang file at build time with a pinned prebuilt slangc into
#   - HLSL text per entry point (profile cs_5_0; compiled at runtime by
#     D3DCompile from d3dcompiler_47.dll), and
#   - one Metal Shading Language library per file (compiled at runtime by
#     -[MTLDevice newLibraryWithSource:]),
# and embeds both plus an entry-point table ([numthreads], structured-buffer
# strides, b0 size) into <target>. gpu::Device::kernel("<file stem>/<entry>")
# looks them up. Every [shader("compute")] function is an entry point.
#
# Binding convention: see core/gpu/gpu.h. Metal argument indices are derived
# from the D3D registers by core/gpu/tools/shaderc.cpp (not by Slang's own
# Metal layout), deterministically:
#   b0 -> buffer(0); t8..15 -> buffer(8..15); u8..15 -> buffer(16..23)
#   t0..7 -> texture(0..7); u0..7 -> texture(8..15); s0/s1 -> sampler(0/1)
#
# #include / import search path: the file's directory and core/ (so shared
# code can live in core/gpu/shaders/). A file is rebuilt when any .slang /
# .slangh in its directory or core/gpu/shaders changes.
#
# Override the compiler with -DNTSCRT_SLANGC=/path/to/slangc.
set(NTSCRT_SLANG_VERSION 2026.19)
set(NTSCRT_SLANGC "" CACHE FILEPATH "slangc to use instead of the pinned download")

function(_ntscrt_slang_fetch out_var)
  if(NTSCRT_SLANGC)
    set(${out_var} ${NTSCRT_SLANGC} PARENT_SCOPE)
    return()
  endif()
  get_property(have GLOBAL PROPERTY _NTSCRT_SLANGC)
  if(have)
    set(${out_var} ${have} PARENT_SCOPE)
    return()
  endif()
  string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}" cpu)
  if(cpu MATCHES "arm64|aarch64")
    set(cpu aarch64)
  else()
    set(cpu x86_64)
  endif()
  # sha256 from the GitHub release asset digests of v2026.19.
  if(CMAKE_HOST_WIN32 AND cpu STREQUAL x86_64)
    set(os windows)
    set(sha fc922f214b5d115f663932e59e80e0f6b6cc6fae140979cf307da6459b6f8f33)
  elseif(CMAKE_HOST_WIN32)
    set(os windows)
    set(sha 6ddc5a56d22690d2077f91edea884f88f8ea35cba4d2f717fc84bf1c2ded766f)
  elseif(CMAKE_HOST_APPLE AND cpu STREQUAL aarch64)
    set(os macos)
    set(sha f77d89b91ec63698a7a8e5aa4316ce08b70d3211a236640ee4551f55be85d9ed)
  elseif(CMAKE_HOST_APPLE)
    set(os macos)
    set(sha c5e18233c0b90cc651c792ec4c4e4a467a9a101ffb6301643aab89c016b48e42)
  elseif(cpu STREQUAL x86_64)
    set(os linux)
    set(sha 758446aa36dd9dc985b6a93e79fff9ed7fc139180c89cb5d3f09427be5d0d2b7)
  else()
    set(os linux)
    set(sha 39632fa19ca3ea9d65253c6f5450d1971a6f3e7b578a1e1998c7ce2b28048221)
  endif()
  set(v ${NTSCRT_SLANG_VERSION})
  include(FetchContent)
  FetchContent_Declare(ntscrt_slang
    URL https://github.com/shader-slang/slang/releases/download/v${v}/slang-${v}-${os}-${cpu}.zip
    URL_HASH SHA256=${sha}
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    SOURCE_SUBDIR _no_cmake_)  # binaries only: populate, don't add_subdirectory
  FetchContent_MakeAvailable(ntscrt_slang)
  set(exe ${ntscrt_slang_SOURCE_DIR}/bin/slangc${CMAKE_HOST_EXECUTABLE_SUFFIX})
  if(NOT EXISTS ${exe})
    message(FATAL_ERROR "slangc not found in the Slang ${v} download (${exe})")
  endif()
  if(NOT CMAKE_HOST_WIN32)
    file(CHMOD ${exe} PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  endif()
  set_property(GLOBAL PROPERTY _NTSCRT_SLANGC ${exe})
  set(${out_var} ${exe} PARENT_SCOPE)
endfunction()

function(ntscrt_add_shaders target)
  set_property(GLOBAL APPEND PROPERTY NTSCRT_SHADER_FILES ${ARGN})
  _ntscrt_slang_fetch(slangc)

  if(NOT TARGET ntscrt_shaderc)
    add_executable(ntscrt_shaderc ${NTSCRT_ROOT}/core/gpu/tools/shaderc.cpp)
    target_link_libraries(ntscrt_shaderc PRIVATE nlohmann_json::nlohmann_json)
    target_compile_features(ntscrt_shaderc PRIVATE cxx_std_17)
  endif()

  set(gen ${CMAKE_BINARY_DIR}/ntscrt_shaders)
  file(MAKE_DIRECTORY ${gen}/tmp)
  string(MAKE_C_IDENTIFIER "${target}" tid)

  get_target_property(agg ${target} NTSCRT_SHADERS_AGG)
  if(NOT agg)
    set(agg ${gen}/${tid}_shaders.cpp)
    set(incs "$<TARGET_PROPERTY:${target},NTSCRT_SHADER_INCS>")
    set(ids "$<TARGET_PROPERTY:${target},NTSCRT_SHADER_IDS>")
    file(GENERATE OUTPUT ${agg} CONTENT
"// Generated by ntscrt_add_shaders() for target ${target} -- do not edit.
#include \"gpu/shader_registry.h\"
#include \"$<JOIN:${incs},\"\n#include \">\"
static const ntscrt::gpu::ShaderFile *const ntscrt_shader_files[] = {
  &ntscrt_shader_file_$<JOIN:${ids},,\n  &ntscrt_shader_file_>};
static const ntscrt::gpu::ShaderRegistrar ntscrt_shader_registrar(
    ntscrt_shader_files, sizeof(ntscrt_shader_files) / sizeof(ntscrt_shader_files[0]));
// Referenced by the HAL so a static library keeps this object (and its registrar).
extern \"C\" void ntscrt_shaders_anchor_${tid}(void) {}
")
    target_sources(${target} PRIVATE ${agg})
    target_include_directories(${target} PRIVATE ${NTSCRT_ROOT}/core)
    set_target_properties(${target} PROPERTIES NTSCRT_SHADERS_AGG ${agg})
  endif()

  file(GLOB shared_deps ${NTSCRT_ROOT}/core/gpu/shaders/*.slang ${NTSCRT_ROOT}/core/gpu/shaders/*.slangh)
  foreach(f ${ARGN})
    get_filename_component(f ${f} ABSOLUTE)
    get_filename_component(stem ${f} NAME_WE)
    get_filename_component(dir ${f} DIRECTORY)
    string(MAKE_C_IDENTIFIER "${stem}" sid)
    get_property(stems GLOBAL PROPERTY _NTSCRT_SHADER_STEMS_${tid})
    if(stem IN_LIST stems)
      message(FATAL_ERROR "ntscrt_add_shaders: shader stem '${stem}' registered twice for ${target}")
    endif()
    set_property(GLOBAL APPEND PROPERTY _NTSCRT_SHADER_STEMS_${tid} ${stem})
    file(GLOB local_deps ${dir}/*.slang ${dir}/*.slangh)
    set(inc ${gen}/${tid}_${sid}.inc)
    add_custom_command(OUTPUT ${inc}
      COMMAND $<TARGET_FILE:ntscrt_shaderc> ${slangc} ${f} ${stem} ${inc} ${gen}/tmp
              -I ${dir} -I ${NTSCRT_ROOT}/core
      DEPENDS ${f} ${local_deps} ${shared_deps} ntscrt_shaderc
      COMMENT "slangc ${stem}.slang -> HLSL + MSL"
      VERBATIM)
    # The rule must live in a target of this directory; the consuming target
    # may be defined elsewhere (stage CMakeLists add to ntscrt_core).
    add_custom_target(ntscrt_shader_${tid}_${sid} DEPENDS ${inc})
    add_dependencies(${target} ntscrt_shader_${tid}_${sid})
    set_property(SOURCE ${agg} TARGET_DIRECTORY ${target} APPEND PROPERTY OBJECT_DEPENDS ${inc})
    set_property(TARGET ${target} APPEND PROPERTY NTSCRT_SHADER_INCS ${inc})
    set_property(TARGET ${target} APPEND PROPERTY NTSCRT_SHADER_IDS ${sid})
  endforeach()
endfunction()
