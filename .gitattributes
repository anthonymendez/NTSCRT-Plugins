* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets: no eol conversion, no text diffs.
*.png binary
*.gif binary
*.webp binary
*.jpg binary
*.icns binary
*.ico binary
*.mp4 binary
*.zip binary
*.dll binary
*.dylib binary

# Upstream presets are copied byte for byte (scripts/sync_upstream.py, checked by scripts/check_sync.py).
presets/** -text
