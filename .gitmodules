[submodule "upstream/NTSCRT"]
	path = upstream/NTSCRT
	url = https://github.com/finnmckenty/NTSCRT
[submodule "vendor/ntsc-rs"]
	path = vendor/ntsc-rs
	url = https://github.com/ntsc-rs/ntsc-rs
	ignore = dirty
[submodule "vendor/librashader"]
	path = vendor/librashader
	url = https://github.com/SnowflakePowered/librashader.git
	ignore = dirty
[submodule "vendor/slang-shaders"]
	path = vendor/slang-shaders
	url = https://github.com/libretro/slang-shaders.git
	ignore = dirty
