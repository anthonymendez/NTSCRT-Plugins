<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Wrapper app: sandboxed, may write only the Motion Templates folder (to
     install the FCP effect template). The temporary-exception entitlement is
     fine for Developer ID distribution (not Mac App Store). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Movies/Motion Templates.localized/</string>
	</array>
</dict>
</plist>
